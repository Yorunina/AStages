{
  "template": "#{{CHANGELOG}}\n\n<details>\n<summary>Uncategorized</summary>\n\n#{{UNCATEGORIZED}}\n</details>",
  "pr_template": "- #{{TITLE}}\n   - PR: ##{{NUMBER}}",
  "categories": [
    {
      "title": "API Changes",
      "labels": ["api"]
    },
    {
      "title": "New Features",
      "labels": ["feat"]
    },
    {
      "title": "Removed Features",
      "labels": ["removed"]
    },
    {
      "title": "Bug Fixes",
      "labels": ["fix"]
    },
    {
      "title": "Performance Improvements",
      "labels": ["perf"]
    }
  ]
}