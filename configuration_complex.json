{
  "template": "## [${{RELEASE_VERSION}}] - ${{RELEASE_DATE}}\n\n#{{CHANGELOG}}\n",
  "pr_template": "- #{{TITLE}}. ([##{{NUMBER}}](#{{URL}}))",
  "categories": [
    {
      "title": "API Changes",
      "labels": ["api"]
    },
    {
      "title": "New Features",
      "labels": ["feat"]
    },
    {
      "title": "Removed Features",
      "labels": ["removed"]
    },
    {
      "title": "Bug Fixes",
      "labels": ["fix"]
    },
    {
      "title": "Performance Improvements",
      "labels": ["perf"]
    }
  ],
  "transformers": [
    {
      "pattern": "^(api|feat|fix|perf|removed):\\s*",
      "target": ""
    }
  ]

}